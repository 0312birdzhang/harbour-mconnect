Name: harbour-mconnect
Summary: Multi-platform music player for Sailfish OS
Version: 1.6.0
Release: 53
Group: Applications/System
License: MIT and GPLv3+
URL: https://github.com/Hjdd14/Mconnect-Music_connect
NoIconCache: true
Sources:
- '%{name}-%{version}.tar.bz2'
Description: |
    Native C++ music services and GStreamer playback with a Sailfish
    Silica interface.
Configure: none
Builder: none
Requires:
- sailjail
- sailfishsilica-qt5
- sailfish-components-pickers-qt5
- qt5-qtwayland-wayland_egl
- gstreamer1.0-plugins-base
- gstreamer1.0-plugins-good
- /usr/share/fonts/wqy-zenhei/wqy-zenhei.ttc
- /usr/share/fonts/sail-sans-pro/SailSansPro-Light.ttf
- /usr/share/fonts/amiri/amiri-regular.ttf
- /usr/share/fonts/notoemoji/NotoEmoji-Regular.ttf
- /usr/share/fonts/dejavu/DejaVuSans.ttf
PkgBR:
- pkgconfig(sailfishapp)
- pkgconfig(Qt5Qml)
- pkgconfig(Qt5Quick)
- pkgconfig(Qt5Gui)
- pkgconfig(Qt5DBus)
- pkgconfig(Qt5Network)
- pkgconfig(sqlite3)
- pkgconfig(zlib)
- pkgconfig(taglib)
- pkgconfig(gstreamer-1.0)
- gcc-c++
- cmake
- make
- python3-base
Files:
- '%config %{_sysconfdir}/sailjail/permissions/harbour-mconnect.profile'
- '%config %{_sysconfdir}/sailjail/permissions/harbour-mconnect-silica.profile'
- '%license %{_datadir}/licenses/%{name}/'
- '%{_bindir}/harbour-mconnect-silica'
- '%{_datadir}/applications/harbour-mconnect-silica.desktop'
- '%{_datadir}/dbus-1/services/org.sailfishos.Mconnect.service'
- '%{_datadir}/icons/hicolor/86x86/apps/harbour-mconnect.png'
- '%{_datadir}/icons/hicolor/108x108/apps/harbour-mconnect.png'
- '%{_datadir}/icons/hicolor/128x128/apps/harbour-mconnect.png'
- '%{_datadir}/icons/hicolor/172x172/apps/harbour-mconnect.png'
- '%{_bindir}/harbour-mconnect'
- '%{_libexecdir}/harbour-mconnect-core'
- '%{_libexecdir}/harbour-mconnect/'
- '%{_datadir}/applications/harbour-mconnect.desktop'
- '%{_datadir}/harbour-mconnect/'
